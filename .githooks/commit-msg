#!/bin/sh
# Fails a commit whose message uses a word GLOSSARY.md lists under _Avoid_. Merge commits are
# skipped, since git writes their message from branch names. Enable once per clone:
#   git config core.hooksPath .githooks
[ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ] && exit 0
# Checks only what was typed: stops at `git commit -v`'s scissors line and drops # comments.
sed -n '/^# -* >8 -*$/q;/^#/!p' "$1" | node "$(git rev-parse --show-toplevel)/scripts/check-glossary.mjs" -
